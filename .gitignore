# =====================================================================
# .gitignore unico della repository Esp32Server
# (progetto principale + tutti i progetti in addon_project/)
# Non creare altri .gitignore nelle sottocartelle: aggiungere qui.
# =====================================================================

# ---------------------------------------------------------------------
# C/C++ - file compilati
# ---------------------------------------------------------------------
# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# ---------------------------------------------------------------------
# PlatformIO / IDE (valgono per tutti i progetti, anche negli addon)
# ---------------------------------------------------------------------
.pio
.cache
.dummy
.vscode
compile_commands.json
build
.DS_Store

# ---------------------------------------------------------------------
# Progetto principale (root)
# ---------------------------------------------------------------------
src/build
src/settingsBakup.h
src/settings.h
/src/settings/*.h
!/src/settings/settingsDefault.h

data/settings/mySettings.json
data/settings/sereSettings.json
data/settings/settings.json
data/settings/sereSettings_1.1.json
data/settings/sereSettings_1.0.json
data/settings/settings_hotspot.json
data/settings/settings_wifi.json
data/settings/effectPreset_sans.json
data/settings/example/defaultSettings.json
data/settings/example/effectPreset_sans.json
data/settings/example/mySettings.json

# ---------------------------------------------------------------------
# addon_project/web_app
# ---------------------------------------------------------------------
# dipendenze npm (ovunque)
node_modules/

addon_project/web_app/led-espert/.continue

addon_project/web_app/led-espert_2/mastro-led-control-cordova/node_modules
addon_project/web_app/led-espert_2/mastro-led-control-cordova/platforms

# Cordova (ex .gitignore locale di mastro-led-control-cordova)
addon_project/web_app/mastro-led-control-cordova/.idea
addon_project/web_app/mastro-led-control-cordova/plugins/
addon_project/web_app/mastro-led-control-cordova/platforms/

# Android (Capacitor) dell'app Vue
addon_project/web_app/mastro-led-control-vue/led-espert/android/.idea
addon_project/web_app/mastro-led-control-vue/led-espert/android/.gradle
addon_project/web_app/mastro-led-control-vue/led-espert/android/local.properties

