; Copiare questo file in "ota_local.ini" (non versionato) e inserire i propri valori.
; Sovrascrive le sezioni [ota] / [ota_*] di platformio.ini (env Esp32Server, upload via WiFi).
;
; Un dispositivo = una sezione [ota_<nome>]:
;   ip       = IP della scheda (in AP_MODE e' 192.168.4.1)
;   password = devicePassword del settings.json di quella scheda
; [ota] target = <nome> sceglie a quale dispositivo fare l'upload
; (oppure al volo, da PowerShell: $env:OTA_TARGET = "esp32_2"; pio run -e Esp32Server -t upload)

[ota]
target = esp32_1

[ota_esp32_1]
ip = 192.168.1.50
password = la_tua_devicePassword

[ota_esp32_2]
ip = 192.168.1.51
password = la_devicePassword_del_secondo
