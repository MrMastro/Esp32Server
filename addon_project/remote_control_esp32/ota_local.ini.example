; Copiare questo file in "ota_local.ini" (non versionato) e inserire i propri valori.
; Sovrascrive le sezioni [ota] / [ota_*] di platformio.ini.
;
; Un dispositivo = una sezione [ota_<nome>]:
;   ip       = IP della scheda (lo mostra lo schermo; in AP_MODE è 192.168.4.1)
;   password = devicePassword del main_settings.json di quella scheda
; [ota] target = <nome> sceglie a quale dispositivo fare l'upload
; (oppure al volo, da PowerShell: $env:OTA_TARGET = "remote2"; pio run -e esp32-c6-lcd-1_3-ota -t upload)

[ota]
target = remote1

[ota_remote1]
ip = 192.168.1.50
password = la_tua_devicePassword

[ota_remote2]
ip = 192.168.1.51
password = la_devicePassword_del_secondo
